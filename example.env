debug=true

database_url=postgresql+asyncpg://tgbot_user:strong_password@postgres:5432/tgbot_db
redis_url=redis://redis:6379
bot_token=YOUR_BOT_TOKEN
owner_ids=[12345678]

support_link=https://t.me/username

channel_id=-100123456789
subscription_price=1234
subscription_days=30

# Early-bird pricing (optional). Users whose first successful payment is
# before the deadline keep early_bird_price forever; before the deadline
# everyone pays early_bird_price. Leave deadline unset to disable.
# Naive datetime = UTC; timezone offsets are also accepted.
early_bird_price=1500
#early_bird_deadline=2026-08-01T00:00:00

prodamus_domain=yourshop.payform.ru
prodamus_secret_key=YOUR_PRODAMUS_SECRET
bot_link=https://t.me/YourBot

webhook_host=https://yourdomain.com
webhook_port=8080

# Astrobot subscription sync (optional). When enabled, gatebot POSTs
# {user_id, subscription_end_date (UTC ISO)} signed with HMAC-SHA256
# (X-Signature header) to astrobot_sync_url after a paid activation.
astrobot_sync_enabled=false
astrobot_sync_url=https://astrobot.example.com/astrobot/gatebot/sync
astrobot_sync_secret=CHANGE_ME_SHARED_WITH_ASTROBOT
