# Telegram Bot Configuration

# Debug mode
debug=false

# Database Configuration
# Format: postgresql+asyncpg://user:password@host:port/database
database_url=postgresql+asyncpg://tgbot_user:strong_password@postgres:5432/tgbot_db

# Redis Configuration
redis_url=redis://redis:6379

# Telegram Bot Token (get from @BotFather)
bot_token=YOUR_BOT_TOKEN_HERE

# Owner Telegram IDs, e.g. [11111111,22222222]
owner_ids=[YOUR_ID_HERE]

# Support & Links
support_link=https://t.me/your_support_channel
bot_link=https://t.me/your_bot_username

# Channel Configuration
channel_id=-100YOUR_CHANNEL_ID
# Цена руб/месяц для новых участников; квартал (-10%) и полгода (-15%) считаются от неё
subscription_price=2000
# Цена руб/месяц для «старичков» (непрерывная подписка, оплаченная до даты отсечки)
subscription_price_legacy=1500
# Дата окончания акции «успей купить по старой цене». Пока текущий момент
# раньше неё, все видят и платят subscription_price_legacy, а каждый оплативший
# получает флаг legacy_pricing (старая цена сохраняется, пока подписка непрерывна).
# Пусто или закомментировано — акция выключена. Можно с таймзоной:
# 2026-08-12T21:00:00+03:00 = до 12 августа 21:00 по Москве.
legacy_promo_until=2026-08-12T21:00:00+03:00

# Payment System (Prodamus)
prodamus_domain=your-domain.payform.ru
prodamus_secret_key=YOUR_PRODAMUS_SECRET_KEY_HERE

# Webhook Configuration (for ngrok or production URL)
webhook_host=https://your-domain.com
webhook_port=8080

# Invite link storage (defaults are fine inside docker)
#invite_link_file=/app/data/invite_link.txt
#invite_link_name=gatebot

# Astrobot subscription sync (optional). When enabled, gatebot POSTs
# {user_id, subscription_end_date (UTC ISO)} signed with HMAC-SHA256
# (X-Signature header) to astrobot_sync_url after a paid activation.
astrobot_sync_enabled=false
astrobot_sync_url=https://astrobot.example.com/astrobot/gatebot/sync
astrobot_sync_secret=CHANGE_ME_SHARED_WITH_ASTROBOT
