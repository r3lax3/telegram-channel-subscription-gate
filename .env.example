# Telegram Bot Configuration

# Debug mode
debug=false

# Database Configuration
# Format: postgresql+asyncpg://user:password@host:port/database
database_url=postgresql+asyncpg://user:password@localhost:5432/database_name

# Redis Configuration
redis_url=redis://localhost:6379

# Telegram Bot Token (get from @BotFather)
bot_token=YOUR_BOT_TOKEN_HERE

# Owner Telegram IDs (comma-separated or array format)
owner_ids=[YOUR_ID_HERE]

# Support & Links
support_link=https://t.me/your_support_channel
bot_link=https://t.me/your_bot_username

# Channel Configuration
channel_id=-100YOUR_CHANNEL_ID
subscription_price=1500
subscription_days=30

# Payment System (Prodamus)
prodamus_domain=your-domain.payform.ru
prodamus_secret_key=YOUR_PRODAMUS_SECRET_KEY_HERE

# Webhook Configuration (for ngrok or production URL)
webhook_host=https://your-domain.com
webhook_port=8080
